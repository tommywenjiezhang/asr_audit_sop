{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ASR Audit Support Desk",
  "version": "1.0.0",
  "identifier": "gov.nj.doh.asrsupportdesk",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist-web"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ASR/Audit Support Desk",
        "width": 1440,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "resources": {
      "../outlook_worker/outlook_worker.py": "outlook_worker/outlook_worker.py"
    },
    "windows": {
      "nsis": { "installMode": "currentUser" }
    }
  }
}
