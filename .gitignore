# ---- Node / frontend ----
node_modules/
# dist/ = release packages (portable ZIP + .sha256); dist-web/ = Vite frontend build embedded in the app
dist/
dist-web/
.vite/
*.local
.env
.env.*
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ---- Rust / Tauri ----
src-tauri/target/
src-tauri/gen/
# Build output is redirected here via CARGO_TARGET_DIR (kept out of OneDrive)
asr-support-desk-target/
target/

# ---- Generated at build time ----
# tauri.conf.windows.json is written by scripts/build.ps1 / demo.ps1
src-tauri/tauri.conf.windows.json

# ---- Python worker ----
__pycache__/
*.pyc
# PyInstaller output (built with scripts/build.ps1 -WithWorkerExe)
build/
*.spec
outlook_worker/outlook_worker.exe
outlook_worker/dist/

# ---- Local runtime data (the app stores real data under %APPDATA%, never in the repo) ----
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
settings.json
logs/
backups/

# ---- Docker build output (installer copied back from the container) ----
installer/

# ---- User guide build cache (sources, images and the final HTML are kept) ----
docs/guide/_output/
docs/guide/.quarto/

# ---- Logs / temp ----
*.log
*.tmp

# ---- OS / editor cruft ----
Thumbs.db
Desktop.ini
.DS_Store
.vscode/
.idea/
*.swp
*~
